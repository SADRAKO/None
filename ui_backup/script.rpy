label start:
    $ xi_trust = 0
    $ solved_01 = False
    $ solved_02 = False
    $ solved_03 = False

    jump chapter_01

label chapter_01:
    scene bg street with fade
    narrator "《地址已失效》"
    narrator "第一章 别急着拆"
    narrator "二十三点十七分。Unix 城，第七旧区。"
    narrator "你入职维护部门的第一天，值班表上就多了一条红色警报。"
    system_text "【第七区：供电异常｜故障源：未定位】"
    system_text "【建议：B-17 线路已进入退役流程】"
    operator "新来的？带上绝缘手套，去 D-17 检修站。有人在那里等你。"
    me "我以为今晚只是熟悉设备。"
    operator "原本是。后来设备也想熟悉一下你。"

    scene bg relay with dissolve
    narrator "检修站的门没有关严。里面传出短促的金属碰撞声。"
    narrator "一个银灰色短发的女孩半跪在配电柜前，黄色小花发夹被她摘下来，仔细放进胸前口袋。"
    xi "把门带上。外面的灰会进来。"
    me "你是负责这里的工程师？"
    xi "希。登记名写 C 也行。"
    me "为什么是 C？"
    xi "旧档案只留下了这个字母。后来就懒得改了。"
    xi "绝缘手套戴好了吗？"
    me "戴好了。工作单也在这里。"
    narrator "她终于抬眼看了你一下。那目光不像审视，更像是在确认一件工具有没有缺角。"
    xi "先说好，我不需要你证明自己有多能干。今晚只要别让事情变得更糟。"
    me "这算欢迎新人的话吗？"
    xi "算提醒。欢迎的话要等设备恢复供电以后再说。"

    xi "断路器已经切开，但我还没确认备用回路完全隔离。先别碰里面。"
    menu:
        "按她的要求，再确认一次隔离状态。":
            $ xi_trust += 1
            me "我来复核编号和指示灯。确认完再动手。"
            xi "好。看标签，不要只看灯。旧设备有时候比人更会装没事。"
        "我以前修过类似设备，先拆开看看。":
            $ xi_trust -= 1
            me "我修过类似的。打开面板，应该很快就能找到问题。"
            xi "停。经验不能替你确认这台设备。退后半步，先核对回路编号。"
            narrator "她的语气并不大声，却让你立刻收回了手。"
            xi "我不是不让你做。我是不想让你在不知道风险的时候做。"
    narrator "你们依次核对开关、标签与备用线路。最后一盏指示灯熄灭，柜门才被允许打开。"
    xi "现在可以了。帮我照这里。"
    me "故障记录上写的是电压波动。"
    xi "那只是结果。"
    me "真正的问题在别处？"
    xi "如果表面显示的就是全部答案，维修员早就失业了。"
    xi "D-17……不，系统把它改名了。现在叫 B-17。系统说它退役了，电流可没这么说。"

    call question_01
    scene bg tunnel with dissolve
    xi "B-17 的末端在下面。我们要去看一眼。"
    me "系统既然标记退役了，直接拆掉不就好了？"
    xi "先确认里面还有没有人在用。不是不能结束，是不能假装自己知道它已经结束。"
    menu:
        "只要还有设备在运行，就应该查清用途。":
            $ xi_trust += 1
            me "至少先弄清楚它还连着什么，再决定要不要拆。"
            xi "嗯。你听懂了。"
        "既然系统判定退役，继续维护只会浪费时间。":
            $ xi_trust -= 1
            me "系统比我们掌握的数据多。也许它只是还没清掉最后一点记录。"
            xi "也许。可系统里没有写“也许”的那一栏。我们去确认。"
    narrator "通道里没有风，墙上的旧线路却发出微弱的嗡鸣。"
    me "你记得这里所有的线路？"
    xi "不记得。我记得哪些地方还没确认。两件事不一样。"
    narrator "通道尽头有一扇窄门。希从钥匙圈上挑出一把磨损严重的小钥匙，试了两次才转动门锁。"
    me "不知道还留着？"
    xi "还没确认它真的没用了。"
    narrator "门后是一排早已停产的控制终端。最里面那台的屏幕裂了一角，电源灯却仍在缓慢闪动。"
    xi "功耗很低，规律脉冲。像是在等待回应。"

    scene bg relay with dissolve
    narrator "故障最终落在一处临时接线：绝缘层被磨破，间歇性地碰到金属框架。"
    me "找到了。"
    xi "先断开，再更换绝缘套，最后做两轮测试。每做完一步告诉我，不要跳步骤。"
    narrator "你们第一次配合得像一支真正的维修小组。二十分钟后，终端的脉冲稳定下来。"
    me "恢复了。"
    xi "先别庆祝。再跑一轮负载测试。"
    me "你真的很不擅长说“干得好”。"
    xi "……干得好。现在去做负载测试。"
    narrator "她说得很认真，像是刚刚学会这句话。"
    narrator "凌晨一点零三分，检修记录终于写完。希把每一项更换、每一次测试和仍未确认的风险都单独列出。"
    me "你可以明天再补这些记录。"
    xi "明天可能会有人接手。他要先知道哪里不能碰。"
    narrator "她的护腕边缘渗出一点血。你拿出急救包，示意她坐下。"
    xi "我可以自己来。"
    me "我知道。你可以自己来，但也可以让我帮忙。"
    narrator "这一次，她没有立刻拒绝。"

    scene bg street with dissolve
    me "B-17 的记录要怎么写？"
    xi "写已恢复供电，终端用途待确认。再申请一次旧档案检索。"
    narrator "签名栏里，她写下一个简短的字母：C。"
    me "明天还要来这里吗？"
    xi "要。明早七点，别迟到。"
    system_text "【B-17：线路状态正常】"
    system_text "【末端设备：未登记】"
    system_text "【目的地址：已失效】"
    narrator "希停下脚步。"
    xi "……把这条也记下来。如果只是地址，系统就不会一直尝试联系它。"
    narrator "第一章 完。"
    jump chapter_02

label question_01:
    $ hint_stage = 0
    $ q_title = "题目一｜重复最久的脉冲码"
    $ q_source = "改编自 Codeforces 977B - Two-gram｜字符串遍历、计数、重叠子串"
    $ q_text = "给定长度为 n 的大写字符串 s，找出出现次数最多的连续两字符子串并输出。出现位置可以重叠；答案不唯一时，输出任意一个即可。\n\n希：旧区设备不会报状态，只会重复自己。B-17 的日志里，有一段两字符脉冲码连续响了三年。你写个程序，把日志里出现次数最多的那段找出来。"
    $ q_sample = "输入：\n7\nABACABA\n\n输出：\nAB\n\n说明：AB 与 BA 都出现 2 次，任意一个都正确。"
    $ q_hints = ["先拿 ABACABA 在纸上走一遍。每一格都由当前字符和它的下一个字符组成一段两字符，不要跳过任何一格。", "长度是 n 的字符串，这样的两字符一共有 n - 1 段。你可以用一张表，把每一段存进去，出现一次就加一。", "开一张 26 × 26 的表，从第 1 位扫到第 n - 2 位，每次看 i 与 i+1。最大值并列时随便挑一个。"]
    $ q_answers = [("A. `ZZ`，出现 2 次。", "correct"), ("B. `ZZ` 只算一次，所以最多是 `ZA`。", "wrong_overlap"), ("C. 取字典序最小的两字符。", "wrong_order")]
    while True:
        $ result = renpy.call_screen("algorithm_question", q_title, q_source, q_text, q_sample, q_hints, q_answers, hint_stage)
        if result == "hint":
            $ hint_stage += 1
        elif result == "correct":
            xi "对。ZZZAA 里位置 1–2 和位置 2–3 都是 ZZ。它们共用了中间那个 Z。"
            me "出现位置可以重叠。"
            xi "对。这正是我自己那版漏掉的情况。"
            $ solved_01 = True
            return
        elif result == "wrong_overlap":
            xi "你数重了。位置 1–2 是 ZZ，位置 2–3 也是 ZZ。出现位置可以重叠。再看一次。"
        else:
            xi "字典序和出现次数没有关系。字母只是名字，次数才是内容。再看一次。"

label chapter_02:
    scene bg office with fade
    narrator "第二章 旧地址"
    narrator "早上六点五十八分。你比约定时间早到了两分钟。"
    narrator "希已经在办公室里。她面前有三叠纸：已完成、待确认，以及没有标签的一叠。"
    me "你几点来的？"
    xi "六点十二分。"
    me "你昨晚几点回去？"
    xi "这个问题和今天的工作有关吗？"
    me "我只是问问。"
    xi "那就不太有关。"
    xi "B-17 的复检申请下来了。今天下午五点以前，要确认旧终端是否可以下线。"
    system_text "【目的地址：BELL/04】"
    system_text "【状态：无法解析｜待确认交接：1 项】"
    me "BELL/04。这是哪里？"
    xi "贝尔研究所旧址。我在那里长大。"
    xi "先去档案室。等我确认自己记得的事情和记录一致以后，我会解释。"

    scene bg archive with dissolve
    narrator "旧档案室里有移动档案柜、纸本索引，以及几台仍能启动的旧终端。"
    xi "档案系统换过两次。旧编号没有全部映射过来。我们从没迁移成功的记录开始找。"
    system_text "【BELL / Maintenance Room 04 / Handover Endpoint】"
    system_text "【未完成项目：维修日志交接确认】"
    me "所以 BELL/04 不是某个人的住址？"
    xi "不是。它是一间维护室的交接端点。旧系统把没有收到确认，当成还需要重试。"
    me "但研究所早就搬走了。"
    xi "嗯。"
    call question_02
    narrator "屏幕上那串重复的登记行被合并成一条。原来几十行记录，其实只是一份日志，被重试了几十次。"
    system_text "【去重完成：原始 47 行 → 有效 1 行】"
    system_text "【交接日志：BELL/04｜提交人：C｜状态：待确认】"
    me "这不是一条等人回来的消息。它是等一份交接记录。"
    xi "是。至少现在，问题有了准确的名字。"

    scene bg office with dissolve
    narrator "档案室外的自动售货机亮着略冷的灯。希买了两罐热饮，把其中一罐放到你手边。"
    xi "你早上没有吃东西。我买的是不加糖的茶，不喜欢可以换。"
    me "你总是这样吗？记住别人需要什么，却不直接问别人想要什么。"
    xi "需要和想要有时候不一样。"
    me "所以才要问。"
    xi "……你也可以直接告诉我。"
    me "我想知道，你是不是愿意让我继续陪你查这件事。"
    xi "工作单上已经写着两个人的名字。"
    me "我问的不是工作单。"
    xi "……愿意。只要你不要把陪我理解成替我做决定。"
    me "好。我会先问。"
    xi "也要听答案。"

    scene bg memory with dissolve
    narrator "你第一次听见希主动谈起贝尔研究所。白色走廊、旧机器、总是坏掉的饮水机，以及一间堆满标签纸的维护室。"
    young_xi "我已经把线路修好了。"
    b "修好了，还是暂时能运行？"
    young_xi "……暂时能运行。"
    b "那就把这句话也写进去。交接记录不是写给昨天的你看的，是写给明天接手的人看的。"
    young_xi "如果明天没有人接手呢？"
    b "那也要写。你不能替未来的人决定他会不会来。"
    narrator "B 把一把旧钥匙放在她掌心。钥匙牌上写着一个褪色的数字：04。"
    b "钥匙只是用来找到门，不是用来把门留在原地。"
    narrator "研究所后来搬迁，新的地址没有回到旧系统。希也没有把那份记录标记为失败。"
    me "你一直以为他会回来补完记录？"
    xi "我以为总有一天会有一份完整的交接。"
    me "这两件事不一样。"
    xi "对。我现在知道了。"

    scene bg terminal with dissolve
    system_text "【TASK: HANDOVER_CONFIRMATION｜OWNER: C｜DESTINATION: BELL/04】"
    me "我们可以把它重新指向档案服务器，完成交接。"
    xi "可以。但必须先确认旧城区传感器已经迁移。否则关掉旧端点，会丢失最后一条状态回报。"
    xi "你来读记录。我检查现场线路。两个人检查，比一个人反复检查更快。"
    narrator "终端闪过一次提示。"
    system_text "【RETRY SCHEDULED: 24 HOURS】"
    narrator "这是旧系统最后一次自动重试。明天下午五点，维护部门就要决定如何安全地结束旧系统。"
    narrator "第二章 完。"
    jump chapter_03

label question_02:
    $ hint_stage = 0
    $ q_title = "题目二｜重复的交接记录"
    $ q_source = "改编自 Codeforces 4C - Registration system｜哈希表、去重"
    $ q_text = "按顺序处理 n 条登记请求。名字未出现过时回答 OK 并登记；已经出现时，输出最小的“名字 + 数字”形式的新名字，并把新名字也登记。\n\n希：旧终端每次重试都会把同一份交接日志再登记一次。它不会判断这条已经登记过了，只会在名字后面接一个序号继续塞进去。"
    $ q_sample = "输入：\n4\nabacaba\nacaba\nabacaba\nacab\n\n输出：\nOK\nOK\nabacaba1\nOK"
    $ q_hints = ["先顺着走一遍四条请求。第二次收到 abacaba 的时候，系统凭什么知道不该再回答 OK？", "别只记出现过几次。要记当前所有已经被占用的名字，包括刚刚生成出去的新名字。", "用一张表查已占名字。没有就回 OK 并登记；有就从 1 往后拼数字，直到拼出表里没有的名字，再把它也登记。"]
    $ q_answers = [("A. `abacaba1` 也一起登记；之后再找 `abacaba2`。", "correct"), ("B. 只记重复次数，第几次就接几。", "wrong_counter"), ("C. 每次把整个队列重新扫一遍。", "wrong_scan")]
    while True:
        $ result = renpy.call_screen("algorithm_question", q_title, q_source, q_text, q_sample, q_hints, q_answers, hint_stage)
        if result == "hint":
            $ hint_stage += 1
        elif result == "correct":
            xi "对。你登记的是已经发出去的名字，不是重复了几次。少登记一行，队列就会在两个名字之间来回撞。"
            $ solved_02 = True
            return
        elif result == "wrong_counter":
            xi "如果系统里本来就有一个 abacaba2 呢？不能只靠次数，要靠这个名字现在有没有被占用。再看一次。"
        else:
            xi "结果也许对，但队列有一万条时你会反复扫一万次。迁移窗口关闭的时候，慢就是错。再看一次。"

label chapter_03:
    scene bg relay with fade
    narrator "第三章 交接人"
    system_text "【B-17 旧终端迁移窗口：今日 17:00 关闭】"
    system_text "【待确认交接：1 项】"
    me "今天必须处理完。"
    xi "今天必须给出结果。两件事不完全一样。"
    narrator "她在纸上画出旧网关与新网关两条路线。"
    me "传感器、日志、旧队列。我们把三项分开验证，再一起切换。切换失败，就恢复旧网关，并且不清理原始队列。"
    xi "好。把这个写进计划。"
    xi "不要因为我交给你，就以为我不再负责。"
    me "我负责执行和记录；你负责跟我确认风险。出了问题，我们一起回滚。"
    xi "……这次算你明白了。"

    scene bg drainage with dissolve
    xi "先看传感器回报，再切换路由。绿灯只代表新端收到了东西，不代表数据正确。"
    me "你为什么一直自己维护这片区域？"
    xi "因为我熟悉这里。"
    me "熟悉不等于只能由你负责。"
    xi "我知道。"
    me "如果只有你能读懂这些记录，它们就还不算真正交接完。"
    xi "……这句话很难反驳。那你先把这件事算清楚。"
    call question_03
    system_text "【本窗口可测：31 项｜推迟：41 项｜推迟原因：已记录】"
    xi "这个风险要写进迁移清单。别只写结论，把原因也写进去。"
    narrator "希按压着手腕，写字的速度比上午慢了许多。"
    me "你的手怎么了？"
    xi "旧柜门的弹簧回弹，碰了一下。不影响检查。"
    me "你已经把同一行数字写错两次了。你需要休息多久？"
    xi "我没说我需要休息。"
    me "你也没说你不需要。传感器测试已经由我记录，路线图由你确认。你休息十五分钟，不会让这项工作失去负责人。"
    xi "你把每件事都拆成了可以替换的步骤。"
    me "因为我不希望你成为唯一一个不能替换的步骤。"
    xi "……听起来不太好听。"
    me "我知道。但我不是说你不重要。我是说，你不应该只能通过一直工作来证明自己重要。"
    xi "十五分钟。但我休息的时候，你不能擅自切换网关。"
    me "我会等你回来一起确认。"

    scene bg terminal with dissolve
    narrator "希短暂离开去清理伤口。迁移控制台上出现一个看似简单的选项：清除无法解析的旧地址。"
    narrator "按钮旁有小字：此操作将关闭待确认队列。"
    menu:
        "等希回来，把风险和计划一起确认。":
            $ xi_trust += 2
            me "不行。先把影响写进变更单，等她回来确认。"
            narrator "你关掉快捷操作窗口，将清除旧地址标记为双人确认后执行。"
            xi "你没有动队列？"
            me "没有。我们还没证明旧队列最后一条状态已经完整迁移。"
            xi "谢谢你等我回来。"
            me "这是共同负责的工作，不是我替你决定的事。"
        "趁她休息，先清除旧地址，让她不用再管这条记录。":
            $ xi_trust -= 1
            narrator "你按下清除按钮。地址从列表里消失，重试提示也停止了。"
            system_text "【旧队列已关闭｜末端状态回报：未确认】"
            narrator "你立刻意识到必须回滚，才能避免下一次刷新显示错误的正常状态。"
            xi "你做了什么？"
            me "我把旧地址清除了。我以为这样能让这件事结束。"
            xi "你没有确认最后一条状态回报。当然可以回滚。现在就回滚。"
            narrator "她快速恢复旧队列、核对传感器状态，直到确认监控数据重新连续。"
            xi "善意不是授权。你可以劝我停下来，但不能因为觉得自己知道什么对我好，就替我关掉我负责的东西。"
            me "……好。谢谢你没有直接走开。"
            xi "我也没有打算走开。我只是不想再重复一次同样的话。"
    narrator "无论刚才发生了什么，旧区都必须在今天完成安全迁移。"

    narrator "距离迁移窗口关闭还有四十分钟。"
    me "传感器连续三次回报一致。新网关收到的数值和旧终端相同。原始记录已经备份，回滚点也保存了。"
    xi "还有最后一项。PENDING_ACK。"
    me "不是直接删除，而是把最终维修日志迁移到新的档案端点，再确认旧交接关闭。"
    narrator "你们逐项确认。没有一步因为看起来没问题就被跳过。"
    system_text "【新网关：运行正常】"
    system_text "【旧区传感器：迁移完成】"
    system_text "【维修日志：已归档】"
    system_text "【BELL/04：端点已失效，历史记录已保存】"
    system_text "【待确认交接：已关闭】"
    xi "结束了。"
    me "嗯。"
    xi "我原本以为，结束的时候应该会有别的感觉。"
    me "记得并不代表你还欠它一份工作。"
    xi "我知道。只是有时候，我会把这两件事弄混。"

    scene bg rooftop with dissolve
    narrator "希把黄色小花发夹重新别好。她拿着那把旧钥匙，却没有像以前那样反复检查钥匙齿。"
    me "你会把钥匙扔掉吗？"
    xi "不会。它是真的存在过。它开过那扇门，也陪我在那里工作过。"
    me "所以它现在可以只是钥匙，不再是一项没完成的任务。"
    xi "……你很擅长把话说得像总结报告。"
    me "这次的结论对吗？"
    xi "对。"
    me "我希望你愿意告诉我什么时候累了，什么时候不想继续，什么时候需要有人陪你一起做。"
    xi "如果我说了，你会怎么做？"
    me "先听你说完。然后问你希望我怎么帮忙。"
    xi "不会直接把我的工作抢过去？"
    me "不会。"
    xi "那我现在有一件事想说。"
    me "我在听。"
    xi "我今天不想再回检修站了。"
    me "好。我们可以去吃饭，也可以只是走一段路。由你选。"
    xi "走一段路吧。今天不用赶时间。"
    narrator "第三章 完。"
    jump good_end

label question_03:
    $ hint_stage = 0
    $ q_title = "题目三｜负载预算"
    $ q_source = "改编自 Codeforces 1185C1 - Exam in BerSU｜排序、贪心、前缀和"
    $ q_text = "给定 n 个测试耗时 a[i] 与总预算 M。对每个 i，输出最少要跳过前面几个测试，才能让剩下测试的总耗时不超过 M；第 i 个测试本身必须保留。\n\n希：迁移窗口总时长有限。我们要挑出预算内、且最能说明问题的测试。挑错了，明天接手的人就得从头再测一遍。"
    $ q_sample = "输入：\n7 15\n1 2 3 4 5 6 7\n\n输出：\n0 0 0 0 0 2 3"
    $ q_hints = ["每一个位置要单独回答，问的是保留这一项时，前面要扔掉几项。先手算第 7 个数。", "第 7 位保留 7，前面六个加起来二十，超了五个。想扔得少，扔 6 和扔 1，哪个更划算？", "对每个 i 保留 a[i]，其余从大到小排序，逐项从总和减掉，直到不超 M。a[i] 本身永远不扔。"]
    $ q_answers = [("A. 先扔耗时最大的几个。", "correct"), ("B. 按最早的测试开始跳。", "wrong_order"), ("C. 超预算就全部重测。", "wrong_all")]
    while True:
        $ result = renpy.call_screen("algorithm_question", q_title, q_source, q_text, q_sample, q_hints, q_answers, hint_stage)
        if result == "hint":
            $ hint_stage += 1
        elif result == "correct":
            xi "对。要最少次数，就只能从最大的开始扔。选择要按代价排，不是按时间排。"
            $ solved_03 = True
            return
        elif result == "wrong_order":
            xi "那样你可能会扔掉三个，而其实两个就够。最早的测试不一定最贵。再看一次。"
        else:
            xi "预算够的那些也被你扔掉了。对每个位置单独求解。再看一次。"

label good_end:
    scene bg ending with fade
    narrator "GOOD END｜地址已更新"
    narrator "一周后，B-17 的迁移记录通过了复核。旧区传感器由新网关接管；过去只存在希记忆里的特殊情况，也被逐条写进了维护手册。"
    narrator "这并没有让维修工作变简单。它只是让一件事不再只能由一个人完成。"
    colleague "希，西侧排水口的例行检查，我已经按你写的步骤完成了。最后一项读数和上周不同，需要你确认一下。"
    xi "好。把记录发给我，我看完再决定需不需要现场复检。"
    narrator "同事离开后，希看了看时钟。距离下班还有一分钟。"
    me "你今天没有准备把那一分钟也用掉吧？"
    xi "我本来打算检查一下明天的工作单。"
    me "明天的工作单，明天再检查。"
    xi "这个建议在逻辑上成立。……我正在执行。"
    narrator "她关掉终端，最终拿起外套，主动走到你身边。"
    xi "我想带你去一个地方。我的住处。"
    narrator "她拿出一张折叠的路线图，在背面写下地址。字迹很规整，下面还画了一个小小的门锁示意图。"
    me "这是邀请？"
    xi "是地址。……也是邀请。"
    xi "门锁有点旧，要往左拧半圈。你到了以后不用站在外面等很久。"
    me "如果你正在休息？"
    xi "那我会告诉你等一下。不是每一次敲门，我都必须立刻回应。"
    me "好。"
    xi "但我会开门。"
    narrator "她把那把旧钥匙放回口袋。你明白，这一次她给出的不是某个旧地址的复制品，而是一条她亲自确认、愿意与你分享的新路径。"
    me "那我什么时候可以去？"
    xi "今天。"
    me "现在？"
    xi "如果你已经下班的话。"
    me "我已经下班了。"
    xi "……那走吧。"
    if solved_01 and solved_02 and solved_03:
        narrator "旧终端里还留着你们一起写下的三段程序与三份说明。它们不再只是答案，而是留给下一位交接人的记录。"
    system_text "【DESTINATION UPDATED】"
    system_text "【地址已更新】"
    system_text "【希（C）路线 · 好结局】"
    xi "这次不用提前告诉我。你也住这里。"
    return
